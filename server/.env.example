# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/campus-portal?retryWrites=true&w=majority

# JWT Secret Key (use a long random string)
JWT_SECRET=your_super_secret_jwt_key_here

# Environment
NODE_ENV=production

# Frontend URL (set this to your Vercel URL after deploying frontend)
CLIENT_URL=https://your-app.vercel.app

# Port (Render sets this automatically, leave as 5000 for local)
PORT=5000
